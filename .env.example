# Copy this file to .env on the BTD server:
#   cp .env.example .env
# Then fill in the AI values. Never commit .env or put real keys in source control.

# --- Compose/build settings (read by compose.yaml, substituted into the image) ---

# Must match the externally served prefix. Requires `docker compose up -d --build`
# to take effect (baked into the client build at image build time).
OPEN_SLIDE_BASE=/slidoo/

# Local bind address/port for the container's port 8080.
OPEN_SLIDE_BIND=127.0.0.1
OPEN_SLIDE_PORT=8080

# --- Runtime settings (read by server/src/config.mjs inside the container) ---

# Shared secret for the upload page. Set this if /upload is publicly reachable,
# otherwise anyone who can reach the site can create decks.
SLIDOO_UPLOAD_TOKEN=

# AI outline drafting: on | off | auto (auto = on when SLIDOO_AI_BASE_URL is set)
SLIDOO_AI=on

# OpenAI-compatible chat/completions endpoint. From inside Docker, do not use
# localhost: it points to the slidoo container itself.
SLIDOO_AI_BASE_URL=https://dts-lab.web.id/ngobrol_ai_router/v1

# Model identifier expected by the configured router/provider.
SLIDOO_MODEL=BTD_worker

# Optional for a local router; required by providers that authenticate requests.
SLIDOO_AI_API_KEY=NANTI AKU ISI

# Longer documents are still accepted; only this many characters are sent to
# the model (the job reports the truncation).
SLIDOO_AI_MAX_CHARS=400000
